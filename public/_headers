# Response headers for the static site. Cloudflare reads this file from dist/ (it is not served)
# and adds these headers to every matching file. The form answers from worker/index.ts set
# their own headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# Astro puts a content hash in every file name here, so a changed file always gets a new name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
